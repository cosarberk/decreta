# --- PostgreSQL ---
POSTGRES_USER=decreta
POSTGRES_PASSWORD=decreta_dev_pw
POSTGRES_DB=decreta
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Postgres'in HOST makinede yayımlanacağı port (konteyner içi hep 5432).
# 5432 doluysa bunu değiştirin.
POSTGRES_HOST_PORT=5433

# --- API ---
API_PORT=4000
NODE_ENV=development
# Üretimde MUTLAKA değiştirin (uzun, rastgele bir değer).
JWT_SECRET=change_me_in_production
# İlk çalıştırmada oluşturulacak admin hesabı (yoksa oluşturulur).
BOOTSTRAP_ADMIN_EMAIL=admin@decreta.local
BOOTSTRAP_ADMIN_PASSWORD=admin
BOOTSTRAP_ADMIN_NAME=Sistem Yöneticisi

# --- Web (yalnızca dev) ---
WEB_PORT=5173
# Dev'de tarayıcının API'ye ulaşacağı adres.
VITE_API_URL=http://localhost:4000

# --- Uygulamanın dışarıdan erişilen kök adresi (e-posta linkleri bununla kurulur) ---
# Dev'de kullanıcı web'i 5173'te açar; e-posta linkleri de oraya gitmeli.
PUBLIC_URL=http://localhost:5173

# --- SMTP (opsiyonel) — boşsa e-posta özelliği sessizce devre dışı kalır ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Decreta <no-reply@decreta.local>
# Self-signed sertifikalı mail sunucusu için false.
SMTP_TLS_REJECT_UNAUTHORIZED=true
