# --- PostgreSQL ---
POSTGRES_USER=decreta
POSTGRES_PASSWORD=decreta_dev_pw
POSTGRES_DB=decreta
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Postgres'in HOST makinede yayımlanacağı port (konteyner içi hep 5432).
# 5432 doluysa bunu değiştirin.
POSTGRES_HOST_PORT=5433

# --- API ---
API_PORT=4000
NODE_ENV=development
# Üretimde MUTLAKA değiştirin (uzun, rastgele bir değer).
JWT_SECRET=change_me_in_production
# İlk çalıştırmada oluşturulacak admin hesabı (yoksa oluşturulur).
BOOTSTRAP_ADMIN_EMAIL=admin@decreta.local
BOOTSTRAP_ADMIN_PASSWORD=admin
BOOTSTRAP_ADMIN_NAME=Sistem Yöneticisi

# --- Web (yalnızca dev) ---
WEB_PORT=5173
# Dev'de tarayıcının API'ye ulaşacağı adres.
VITE_API_URL=http://localhost:4000
